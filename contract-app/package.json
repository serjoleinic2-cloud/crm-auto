{
  "name": "contract-local",
  "version": "0.1.3",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/main.test.js tests/input-formats.test.js tests/documents.test.js",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "29.4.6",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "docxtemplater": "3.69.3",
    "pizzip": "3.2.0",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "build": {
    "appId": "com.local.contracts",
    "productName": "Local Contracts",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "templates/**/*",
      "assets/**/*"
    ],
    "portable": {
      "artifactName": "Local-Contracts-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Local-Contracts-${version}-setup.exe"
    },
    "win": {
      "icon": "assets/icon.ico"
    }
  }
}
