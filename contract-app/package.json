{
  "name": "contract-local",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/main.test.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "29.4.6",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "docxtemplater": "3.69.3",
    "pizzip": "3.2.0",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "build": {
    "appId": "com.local.contracts",
    "productName": "Local Contracts",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "templates/**/*"
    ]
  }
}
